{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onboarding_wiki.schema.json",
  "title": "Career Wiki onboarding generation output",
  "description": "Structured Career Wiki generated from a user's resume text and guided Q&A answers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate",
    "gates",
    "paid",
    "search",
    "facts_md",
    "rubric_md",
    "wiki_summary",
    "follow_up_questions"
  ],
  "properties": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "email",
        "degree",
        "gpa",
        "graduation_year",
        "degree_completed",
        "fulltime_experience_years",
        "languages",
        "test_scores",
        "nationality",
        "based_in"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string" },
        "degree": { "type": "string" },
        "gpa": {
          "description": "Candidate GPA if explicitly stated in the resume or Q&A, otherwise 0.",
          "type": "number"
        },
        "graduation_year": { "type": "integer" },
        "degree_completed": { "type": "boolean" },
        "fulltime_experience_years": { "type": "number" },
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "test_scores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exam", "score"],
            "properties": {
              "exam": { "type": "string", "minLength": 1 },
              "score": { "type": "number" }
            }
          }
        },
        "nationality": { "type": "string" },
        "based_in": { "type": "string" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass_max_years",
        "ask_max_years",
        "available_th",
        "available_abroad",
        "pass_cities",
        "pass_countries",
        "remote",
        "internship",
        "contract"
      ],
      "properties": {
        "pass_max_years": { "type": "number" },
        "ask_max_years": { "type": "number" },
        "available_th": {
          "description": "Earliest local start month in YYYY-MM format.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "available_abroad": {
          "description": "Earliest relocation/visa start month in YYYY-MM format.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "pass_cities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "pass_countries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "remote": { "type": "string", "enum": ["pass", "ask", "fail"] },
        "internship": { "type": "string", "enum": ["pass", "ask", "fail"] },
        "contract": { "type": "string", "enum": ["pass", "ask", "fail"] }
      }
    },
    "paid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchors_thb_month"],
      "properties": {
        "anchors_thb_month": {
          "description": "Exactly 4 ascending gross monthly THB salary cutoffs separating Paid scores 1..5.",
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords", "title_exclude_extra"],
      "properties": {
        "keywords": {
          "description": "6 to 12 job search keywords tailored to the candidate's target roles.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "title_exclude_extra": {
          "description": "Role keywords the candidate explicitly wants to exclude (plain words, not regex).",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "facts_md": {
      "description": "Complete Markdown file for config/facts.md containing ## Identity & Contact, ## Experience & Projects, ## Skills & Education, and ## Banned phrases with numbered facts F01..Fn strictly grounded in the user's resume and Q&A.",
      "type": "string",
      "minLength": 80
    },
    "rubric_md": {
      "description": "Complete Markdown file for config/rubric.md defining 1..5 anchors for What you love, What you are good at, and What the world needs tailored to this candidate.",
      "type": "string",
      "minLength": 80
    },
    "wiki_summary": {
      "description": "Friendly 2-4 sentence summary explaining what the AI extracted into the Career Wiki and how jobs will now be scored.",
      "type": "string",
      "minLength": 20
    },
    "follow_up_questions": {
      "description": "2 to 3 targeted follow-up questions asking for missing metrics, constraints, or preferences that could make the Career Wiki even sharper.",
      "type": "array",
      "items": { "type": "string", "minLength": 5 }
    }
  }
}
